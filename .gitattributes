# Normalise text files in the repository; checkout uses the platform default.
* text=auto

# Files that must keep LF so they work on Linux CI and in POSIX shells
Makefile    text eol=lf
*.mk        text eol=lf
*.sh        text eol=lf
*.yml       text eol=lf
*.ld        text eol=lf

# mtk3_bsp2 is a copy of upstream: store its files exactly as upstream has them
# (CRLF), so they compare 1:1 with tron-forum/mtk3_bsp2.
mtk3_bsp2/** -text

# Binary
*.png       binary
*.jpg       binary
*.pdf       binary
